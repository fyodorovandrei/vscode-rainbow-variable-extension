{
  "name": "rainbow-variable-extension-for-vscode",
  "displayName": "Rainbow Variable for VS Code",
  "description": "Color method parameters and local variables with distinct rainbow colors.",
  "version": "1.0.1",
  "publisher": "fyodorovandrei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fyodorovandrei/vscode-rainbow-variable-extension.git"
  },
  "icon": "./assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rainbowVariables.refresh",
        "title": "Rainbow Variables: Refresh"
      },
      {
        "command": "rainbowVariables.showStatus",
        "title": "Rainbow Variables: Show Status"
      },
      {
        "command": "rainbowVariables.toggle",
        "title": "Rainbow Variables: Toggle"
      }
    ],
    "configuration": {
      "title": "Rainbow Variables",
      "properties": {
        "rainbowVariables.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable variable and parameter rainbow coloring."
        },
        "rainbowVariables.colors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#e06c75",
            "#d19a66",
            "#e5c07b",
            "#98c379",
            "#56b6c2",
            "#61afef",
            "#c678dd",
            "#be5046"
          ],
          "description": "Colors assigned to parameters and variables, repeating when a scope contains more identifiers than colors."
        },
        "rainbowVariables.fontWeight": {
          "type": "string",
          "default": "600",
          "description": "Font weight applied to highlighted identifiers. Use normal to keep theme weight unchanged."
        },
        "rainbowVariables.includeParameters": {
          "type": "boolean",
          "default": true,
          "description": "Color function and method parameters."
        },
        "rainbowVariables.includeVariables": {
          "type": "boolean",
          "default": true,
          "description": "Color local variables declared inside functions and methods."
        },
        "rainbowVariables.includeImports": {
          "type": "boolean",
          "default": true,
          "description": "Color imported bindings and their usages."
        },
        "rainbowVariables.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "typescript",
            "typescriptreact",
            "javascript",
            "javascriptreact"
          ],
          "description": "VS Code language IDs where Rainbow Variables should run."
        },
        "rainbowVariables.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "description": "Skip highlighting documents larger than this size in KB."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && npm exec --yes --package @vscode/vsce -- vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
